# ---------------------------------------------------------------------------
# RecallRaid environment configuration template.
# Copy to .env (root, gitignored) and per-app .env.local as noted below.
# NEVER commit real secrets. PUBLIC vars are safe in a client bundle;
# SERVER-ONLY and SECRET vars must only exist in apps/api's runtime env
# (Fly.io secrets) and never in apps/web.
# ---------------------------------------------------------------------------

# ==== PUBLIC (safe in apps/web/.env.local, exposed to the browser) ====
NEXT_PUBLIC_REOWN_PROJECT_ID=12f8ec749466943d20d79fc58594f9cd
NEXT_PUBLIC_API_BASE_URL=https://recallraid-api.fly.dev
NEXT_PUBLIC_GENLAYER_CHAIN=studionet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_RECALLRAID_ESCROW_ADDRESS=

# ==== SERVER-ONLY (apps/api runtime env — Fly.io secrets, never in web bundle) ====
DATABASE_URL=postgres://recallraid:changeme@localhost:5432/recallraid
PORT=8080
NODE_ENV=production
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
RECALLRAID_ESCROW_ADDRESS=
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=
CORS_ALLOWED_ORIGIN=https://recall-raid.vercel.app

# ==== SECRET (apps/api only — set via `fly secrets set`, never written to disk in repo) ====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=recallraid-evidence
JWT_SIGNING_SECRET=
