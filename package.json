{
  "name": "recallraid",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "test:api": "npm run test --workspace apps/api",
    "test:base": "forge test",
    "migrate": "npm run migrate --workspace apps/api",
    "lint:contract": "node scripts/lint_contract.mjs",
    "compile:contract": "python3 -m py_compile contracts/recallraid_contract.py",
    "compile:base": "node contracts/base/compile.mjs",
    "deploy:base": "node contracts/base/deploy.mjs",
    "verify:base": "node contracts/base/verify.mjs"
  },
  "devDependencies": {
    "solc": "^0.8.30"
  }
}
